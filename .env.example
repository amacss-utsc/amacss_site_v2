# Added by Payload
# Database connection string
DATABASE_URI=
# Used to encrypt JWT tokens
PAYLOAD_SECRET=
# Used to format links and URLs
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Allow robots to index the site (optional)
NEXT_PUBLIC_IS_LIVE=
# Used to preview drafts
PAYLOAD_PUBLIC_DRAFT_SECRET=demo-draft-secret
NEXT_PRIVATE_DRAFT_SECRET=demo-draft-secret
# Used to revalidate static pages
REVALIDATION_KEY=demo-revalation-key
NEXT_PRIVATE_REVALIDATION_KEY=demo-revalation-key

S3_BUCKET=amacss-site-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=

# Public values from Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by the existing registration image upload route.
# Use the service-role key and never prefix this variable with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_KEY=
# Optionally use a separate server secret key for verification and notification DB writes.
SUPABASE_SECRET_KEY=

# Resend: verify the sending domain before using this sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AMACSS <events@amacss.org>
# Generate with: openssl rand -hex 32
EMAIL_VERIFICATION_SECRET=

# The hourly dispatch endpoint requires this bearer token.
CRON_SECRET=

# Optional SMS. All five values are needed before the consent checkbox appears.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
SMS_TERMS_URL=https://amacss.org/sms-terms
SMS_PRIVACY_URL=https://amacss.org/sms-privacy

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

INTERNAL_EVENT_REFERRAL_CODE=
