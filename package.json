{
  "name": "amacss-site",
  "version": "1.0.0",
  "url": "https://www.github.com/nikolasmorado",
  "description": "AMACSS Payload Site",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "local-build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "prod-build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "audit": "pnpm audit",
    "test:security": "node --experimental-strip-types --test --test-isolation=none tests/security.test.ts",
    "typecheck": "tsc --noEmit",
    "test:security:integration": "cross-env NODE_ENV=production payload run tests/payload-security.integration.ts",
    "migrate:status": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate:status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "geist": "^1.9.2",
    "graphql": "^16.15.0",
    "gsap": "^3.15.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "octokit": "^5.0.5",
    "payload": "3.93.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-day-picker": "8.10.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hot-toast": "^2.6.1",
    "react-lottie": "^1.2.10",
    "react-markdown": "^10.1.0",
    "referral-codes": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.6",
    "@tailwindcss/typography": "^0.5.20",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{ts, tsx}": "eslint --cache --fix",
    "*.{ts, tsx, css, md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17",
      "happy-dom": "^21.0.4",
      "katex": "^0.19.1",
      "postcss-selector-parser@6": "^6.1.5",
      "minimatch@>=7 <11": "^11.0.1",
      "@esbuild-kit/core-utils>esbuild": "^0.28.2"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
      "monaco-editor@0.55.1": "patches/monaco-editor@0.55.1.patch",
      "@payloadcms/ui@3.93.0": "patches/@payloadcms__ui@3.93.0.patch"
    }
  }
}
