{
  "name": "amacss-site",
  "version": "1.0.0",
  "url": "https://www.github.com/nikolasmorado",
  "description": "AMACSS Payload Site",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "local-build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "prod-build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:prod": "pnpm local-build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:backend-usage": "node tests/backend-usage.test.cjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@splidejs/react-splide": "^0.7.12",
    "@splidejs/splide": "^4.1.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "geist": "^1.9.0",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "katex": "^0.19.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "octokit": "^5.0.5",
    "payload": "3.92.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "referral-codes": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "lint-staged": {
    "*.{ts, tsx}": "eslint --cache --fix",
    "*.{ts, tsx, css, md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "happy-dom": "21.0.4",
      "@esbuild-kit/core-utils>esbuild": "0.28.2",
      "postcss-selector-parser@6": "6.1.5",
      "minimatch": "11.0.3",
      "katex": "0.19.1"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
      "eslint-plugin-import@2.32.0": "patches/eslint-plugin-import@2.32.0.patch"
    }
  }
}
